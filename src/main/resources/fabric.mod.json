{
  "schemaVersion": 1,
  "id": "moddeck",
  "version": "${version}",
  "name": "Mod Deck",
  "description": "Declarative, reusable configuration screens for Fabric mods.",
  "icon": "assets/moddeck/icon.png",
  "authors": ["yoima"],
  "contact": {
    "homepage": "https://modrinth.com/project/mod-deck",
    "sources": "https://github.com/yoima-jp/ModDeck",
    "issues": "https://github.com/yoima-jp/ModDeck/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.yoima.moddeck.ModDeck"],
    "client": ["com.yoima.moddeck.client.ModDeckClient"]
  },
  "mixins": [
    {
      "config": "moddeck.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.161.0"
  }
}
